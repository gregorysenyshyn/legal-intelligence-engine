#!/usr/bin/env bash
# ==============================================================================
# Ontario Family Law Practice Assistant - Root CLI Runner (./firm)
# Automatically locates the local virtual environment and executes subcommands.
# ==============================================================================

set -e

# Resolve directory of this script
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Find Python interpreter
if [ -f "$SCRIPT_DIR/.venv/bin/python" ]; then
    PYTHON_BIN="$SCRIPT_DIR/.venv/bin/python"
elif [ -f "$SCRIPT_DIR/../.venv/bin/python" ]; then
    PYTHON_BIN="$SCRIPT_DIR/../.venv/bin/python"
elif command -v python3 &>/dev/null; then
    PYTHON_BIN="python3"
else
    echo "Error: Python 3 virtual environment not found." >&2
    echo "Run: python3 -m venv .venv && source .venv/bin/activate && pip install -r requirements.txt" >&2
    exit 1
fi

export PYTHONPATH="$SCRIPT_DIR/src:$PYTHONPATH"
exec "$PYTHON_BIN" "$SCRIPT_DIR/src/cli/main.py" "$@"

